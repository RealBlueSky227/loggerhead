#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
from contextlib import contextmanager
from pathlib import Path
from typing import Any

ALLOWED_GPIOS = {4, 5, 6, 9, 10, 11, 17, 22, 26, 27}
STATE_DIR = Path("/run/loggerhead-onewire")
STATE_PATH = STATE_DIR / "owned.json"
LOCK_PATH = STATE_DIR / "lock"
W1_ROOT = Path("/sys/bus/w1/devices")
DTOVERLAY = shutil.which("dtoverlay") or "/usr/bin/dtoverlay"
PINCTRL = shutil.which("pinctrl") or "/usr/bin/pinctrl"
RASPI_GPIO = shutil.which("raspi-gpio") or "/usr/bin/raspi-gpio"


class HelperError(RuntimeError):
    pass


def main() -> None:
    try:
        payload = handle(sys.argv[1:])
    except Exception as exc:
        print(json.dumps({"ok": False, "message": str(exc)}))
        sys.exit(1)
    print(json.dumps(payload, sort_keys=True))


def handle(argv: list[str]) -> dict[str, Any]:
    if os.geteuid() != 0:
        raise HelperError("loggerhead-onewire-helper must run as root via restricted sudo.")
    if not argv:
        raise HelperError("usage: loggerhead-onewire-helper activate|release|status [gpio]")
    operation = argv[0]
    gpio = _parse_gpio(argv[1]) if len(argv) > 1 else None
    if operation in {"activate", "release"} and gpio is None:
        raise HelperError(f"{operation} requires a GPIO number.")
    if operation == "status" and len(argv) != 1:
        raise HelperError("status does not accept a GPIO argument.")
    STATE_DIR.mkdir(mode=0o755, parents=True, exist_ok=True)
    with locked():
        if operation == "activate":
            assert gpio is not None
            return activate(gpio)
        if operation == "release":
            assert gpio is not None
            return release(gpio)
        if operation == "status":
            return status()
    raise HelperError(f"Unsupported operation {operation!r}.")


def _parse_gpio(raw: str) -> int:
    try:
        gpio = int(raw, 0)
    except ValueError as exc:
        raise HelperError(f"GPIO {raw!r} is not an integer.") from exc
    if gpio not in ALLOWED_GPIOS:
        raise HelperError(f"BCM GPIO {gpio} is not an approved Loggerhead SensePort pin.")
    return gpio


@contextmanager
def locked():
    try:
        import fcntl  # type: ignore
    except ImportError:
        yield
        return
    with LOCK_PATH.open("w", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def activate(gpio: int) -> dict[str, Any]:
    state = load_state()
    overlays = list_overlays()
    existing = overlay_for_gpio(overlays, gpio)
    if existing is not None:
        entry = state["owned_gpios"].get(str(gpio))
        owned = bool(entry and overlay_matches(entry, existing))
        if entry and not owned:
            state["owned_gpios"].pop(str(gpio), None)
            save_state(state)
        bus_master = str(entry.get("bus_master", "")) if owned and isinstance(entry, dict) else ""
        return payload(
            "activate",
            gpio,
            created=False,
            owned=owned,
            already_active=True,
            bus_master=bus_master,
            overlays=overlays,
            message="Runtime w1-gpio overlay already active." if owned else "w1-gpio overlay is active but not owned by Loggerhead.",
        )
    before_masters = list_w1_master_names()
    run([DTOVERLAY, "w1-gpio", f"gpiopin={gpio}"], timeout=8.0)
    overlays = list_overlays()
    created = overlay_for_gpio(overlays, gpio)
    if created is None:
        raise HelperError(f"dtoverlay reported success but no runtime w1-gpio overlay appeared for BCM GPIO {gpio}.")
    bus_master = wait_for_new_w1_master(before_masters)
    state["owned_gpios"][str(gpio)] = {
        "activated_at": time.time(),
        "overlay": overlay_identity(created),
        "bus_master": bus_master,
    }
    save_state(state)
    return payload(
        "activate",
        gpio,
        created=True,
        owned=True,
        bus_master=bus_master,
        overlays=overlays,
        message="Runtime w1-gpio overlay activated.",
    )


def release(gpio: int) -> dict[str, Any]:
    state = load_state()
    overlays = list_overlays()
    existing = overlay_for_gpio(overlays, gpio)
    entry = state["owned_gpios"].get(str(gpio))
    if entry is None:
        if existing is not None:
            raise HelperError(f"BCM GPIO {gpio} has an active w1-gpio overlay that is not owned by Loggerhead; refusing removal.")
        return payload(
            "release",
            gpio,
            ok=True,
            owned=False,
            overlays=overlays,
            message="No Loggerhead-owned runtime overlay recorded for this GPIO; leaving kernel state unchanged.",
        )
    if existing is None:
        state["owned_gpios"].pop(str(gpio), None)
        save_state(state)
        safe_input = set_gpio_input(gpio)
        return payload(
            "release",
            gpio,
            ok=True,
            owned=True,
            safe_input=safe_input,
            overlays=overlays,
            message="Recorded Loggerhead overlay was already absent; GPIO input handoff attempted.",
        )
    if not overlay_matches(entry, existing):
        state["owned_gpios"].pop(str(gpio), None)
        save_state(state)
        raise HelperError(
            f"Recorded Loggerhead ownership for BCM GPIO {gpio} no longer matches the active overlay; refusing removal."
        )
    affected = tuple(
        sorted(
            {
                overlay_gpio(item)
                for item in overlays
                if int(item["index"]) > int(existing["index"]) and item["name"] == "w1-gpio" and overlay_gpio(item) is not None
            }
        )
    )
    run([DTOVERLAY, "-r", str(existing["index"])], timeout=12.0)
    state["owned_gpios"].pop(str(gpio), None)
    save_state(state)
    safe_input = set_gpio_input(gpio)
    overlays_after = list_overlays()
    return payload(
        "release",
        gpio,
        ok=True,
        owned=True,
        affected_gpios=affected,
        safe_input=safe_input,
        overlays=overlays_after,
        message=(
            "Runtime overlay released. Later overlays may have been temporarily removed and reapplied."
            if affected
            else "Runtime overlay released."
        ),
    )


def status() -> dict[str, Any]:
    state = load_state()
    owned_bus_masters = {
        str(gpio): str(entry["bus_master"])
        for gpio, entry in state["owned_gpios"].items()
        if isinstance(entry, dict) and entry.get("bus_master")
    }
    return {
        "ok": True,
        "action": "status",
        "gpio": -1,
        "owned_gpios": sorted(int(item) for item in state["owned_gpios"]),
        "owned_bus_masters": owned_bus_masters,
        "allowed_gpios": sorted(ALLOWED_GPIOS),
        "overlays": list_overlays(),
    }


def payload(
    action: str,
    gpio: int,
    *,
    ok: bool = True,
    created: bool = False,
    owned: bool = False,
    already_active: bool = False,
    affected_gpios: tuple[int, ...] = (),
    safe_input: bool | None = None,
    bus_master: str = "",
    overlays: list[dict[str, Any]] | None = None,
    message: str = "",
) -> dict[str, Any]:
    return {
        "ok": ok,
        "action": action,
        "gpio": gpio,
        "created": created,
        "owned": owned,
        "already_active": already_active,
        "affected_gpios": list(affected_gpios),
        "safe_input": safe_input,
        "bus_master": bus_master,
        "overlays": overlays or [],
        "message": message,
    }


def run(command: list[str], *, timeout: float) -> subprocess.CompletedProcess[str]:
    try:
        result = subprocess.run(command, capture_output=True, check=False, text=True, timeout=timeout)
    except Exception as exc:
        raise HelperError(f"{command[0]} failed to run: {exc}") from exc
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit code {result.returncode}"
        raise HelperError(f"{' '.join(command)} failed: {detail}")
    return result


def list_overlays() -> list[dict[str, Any]]:
    result = run([DTOVERLAY, "-l"], timeout=5.0)
    overlays: list[dict[str, Any]] = []
    for line in result.stdout.splitlines():
        line = line.strip()
        if not line or ":" not in line:
            continue
        left, right = line.split(":", 1)
        try:
            index = int(left.strip())
        except ValueError:
            continue
        parts = right.strip().split()
        if not parts:
            continue
        params: dict[str, str] = {}
        for part in parts[1:]:
            if "=" not in part:
                continue
            key, value = part.split("=", 1)
            params[key.strip()] = value.strip().strip(",")
        overlays.append({"index": index, "name": parts[0], "params": params})
    return overlays


def overlay_for_gpio(overlays: list[dict[str, Any]], gpio: int) -> dict[str, Any] | None:
    for item in overlays:
        if item["name"] == "w1-gpio" and overlay_gpio(item) == gpio:
            return item
    return None


def overlay_gpio(item: dict[str, Any]) -> int | None:
    params = dict(item.get("params", {}))
    if item.get("name") != "w1-gpio":
        return None
    raw = params.get("gpiopin")
    if raw is None:
        return 4
    try:
        return int(raw, 0)
    except ValueError:
        return None


def overlay_identity(item: dict[str, Any]) -> dict[str, Any]:
    return {
        "index": int(item["index"]),
        "name": str(item["name"]),
        "params": {str(key): str(value) for key, value in dict(item.get("params", {})).items()},
    }


def overlay_matches(entry: dict[str, Any], item: dict[str, Any]) -> bool:
    recorded = entry.get("overlay")
    if not isinstance(recorded, dict):
        return False
    return recorded == overlay_identity(item)


def list_w1_master_names() -> set[str]:
    return {path.name for path in W1_ROOT.glob("w1_bus_master*") if path.is_dir()}


def wait_for_new_w1_master(before: set[str]) -> str:
    deadline = time.monotonic() + 2.0
    while time.monotonic() < deadline:
        created = sorted(list_w1_master_names() - before)
        if len(created) == 1:
            return created[0]
        if len(created) > 1:
            return ""
        time.sleep(0.1)
    return ""


def set_gpio_input(gpio: int) -> bool:
    commands = ([PINCTRL, "set", str(gpio), "ip"], [RASPI_GPIO, "set", str(gpio), "ip"])
    for command in commands:
        if not Path(command[0]).exists():
            continue
        result = subprocess.run(command, capture_output=True, check=False, text=True, timeout=3.0)
        if result.returncode == 0:
            return gpio_is_input(gpio)
    return False


def gpio_is_input(gpio: int) -> bool:
    checks = ([PINCTRL, "get", str(gpio)], [RASPI_GPIO, "get", str(gpio)], [shutil.which("gpioinfo") or "/usr/bin/gpioinfo", "gpiochip0"])
    for command in checks:
        if not Path(command[0]).exists():
            continue
        result = subprocess.run(command, capture_output=True, check=False, text=True, timeout=3.0)
        if result.returncode != 0:
            continue
        text = result.stdout
        lowered = text.lower()
        if command[1] == "get" and ("func=input" in lowered or " ip " in lowered or lowered.strip().endswith(" ip")):
            return True
        if command[0].endswith("gpioinfo"):
            for line in text.splitlines():
                if f"line {gpio}:" in line.lower() and "input" in line.lower() and "consumer=" not in line.lower():
                    return True
    return False


def load_state() -> dict[str, Any]:
    try:
        with STATE_PATH.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, json.JSONDecodeError):
        data = {}
    owned = data.get("owned_gpios", {})
    return {"owned_gpios": owned if isinstance(owned, dict) else {}}


def save_state(state: dict[str, Any]) -> None:
    tmp = STATE_PATH.with_suffix(".tmp")
    with tmp.open("w", encoding="utf-8") as handle:
        json.dump(state, handle, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(tmp, STATE_PATH)


if __name__ == "__main__":
    main()
